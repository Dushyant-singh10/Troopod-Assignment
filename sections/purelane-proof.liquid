{{ 'section-purelane-proof.css' | asset_url | stylesheet_tag }}

<div class="purelane-section sec" id="proof-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        
        <!-- Left Side Copy -->
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
          <p class="body-s" style="max-width:40ch; margin-bottom: 24px;">{{ section.settings.description }}</p>
          {%- if section.settings.btn_text != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.btn_link | default: '#ingredients' }}">
              {{ section.settings.btn_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>

        <!-- Right Side Slideshow Rotator -->
        <div class="glass-2 rot" id="rot-{{ section.id }}" aria-hidden="true">
          <div class="frame">
            <span class="pimg p-kitchen on" role="img" aria-label="Purelane foaming kitchen cleaner" data-name="Kitchen cleaner" data-note="Foam lifts grease, no scrubbing"></span>
            <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover" data-name="Tap &amp; limescale" data-note="Melts hard water stains"></span>
            <span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent" data-name="Laundry detergent" data-note="Tough on odour, soft on fabric"></span>
            <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner" data-name="Toilet cleaner" data-note="Kills 99.9% of germs"></span>
            <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner" data-name="Floor cleaner" data-note="Neem powered, pet safe"></span>
            <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel" data-name="Dishwash gel" data-note="Cuts grease, kind to hands"></span>
          </div>
          <div class="cap">
            <b>Kitchen cleaner</b>
            <span>Foam lifts grease, no scrubbing</span>
          </div>
          <div class="dots">
            <i class="on"></i><i></i><i></i><i></i><i></i><i></i>
          </div>
        </div>

        <!-- Bottom Stats Row -->
        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <div class="ring">{{ block.settings.value }}</div>
                <h5>{{ block.settings.label }}</h5>
                <p>{{ block.settings.desc }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>
</div>

<script>
(function() {
  function initRotator() {
    var rot = document.getElementById('rot-{{ section.id }}');
    if (!rot) return;
    var rimgs = [].slice.call(rot.querySelectorAll('.frame .pimg'));
    var rdots = [].slice.call(rot.querySelectorAll('.dots i'));
    var rcapB = rot.querySelector('.cap b');
    var rcapS = rot.querySelector('.cap span');
    var ri = 0, rtimer = null;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function rstep() {
      rimgs[ri].classList.remove('on');
      if (rdots[ri]) rdots[ri].classList.remove('on');
      ri = (ri + 1) % rimgs.length;
      rimgs[ri].classList.add('on');
      if (rdots[ri]) rdots[ri].classList.add('on');
      rcapB.innerHTML = rimgs[ri].getAttribute('data-name');
      rcapS.textContent = rimgs[ri].getAttribute('data-note');
    }

    if (!reduce) {
      if (window.IntersectionObserver) {
        var rio = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting && !rtimer) {
              rtimer = setInterval(rstep, 2900);
            } else if (!e.isIntersecting && rtimer) {
              clearInterval(rtimer);
              rtimer = null;
            }
          });
        }, { threshold: 0.25 });
        rio.observe(rot);
      } else {
        rtimer = setInterval(rstep, 2900);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initRotator);
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.id.indexOf('proof') > -1) {
      initRotator();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Purelane Proof",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Tough on grime.<br>Gentle on everything else."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat Value",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Germ kill"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Stat Description",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Proof & Rotator",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "99.9%",
            "label": "Germ kill",
            "desc": "Tested against germs and bacteria"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "0%",
            "label": "Sulphates",
            "desc": "No SLS, chlorine or parabens"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "Plant based",
            "desc": "Cleansers derived from plants"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "4.8",
            "label": "Rated",
            "desc": "Across 8,000+ verified reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
