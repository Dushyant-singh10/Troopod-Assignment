{{ 'section-purelane-bundles.css' | asset_url | stylesheet_tag }}

<div class="purelane-section purelane-bundles-section" id="bundles" data-scene="3">
  <section class="sec">
    <div class="wrap">
      
      <!-- Top Frost Panel Header -->
      <div class="glass sec-pad rv" style="margin-bottom:16px">
        <div class="panel-head" style="margin-bottom:0">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.headline }}</h2>
          {%- if section.settings.description != blank -%}
            <p class="lede" style="margin:0 auto">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      </div>

      <!-- Tiers Grid -->
      <div class="tiers">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tier' -%}
            
            {%- assign pix_count = 0 -%}
            {%- if block.settings.img_1 != 'none' -%}{%- assign pix_count = pix_count | plus: 1 -%}{%- endif -%}
            {%- if block.settings.img_2 != 'none' -%}{%- assign pix_count = pix_count | plus: 1 -%}{%- endif -%}
            {%- if block.settings.img_3 != 'none' -%}{%- assign pix_count = pix_count | plus: 1 -%}{%- endif -%}
            {%- if block.settings.img_4 != 'none' -%}{%- assign pix_count = pix_count | plus: 1 -%}{%- endif -%}
            {%- if block.settings.img_5 != 'none' -%}{%- assign pix_count = pix_count | plus: 1 -%}{%- endif -%}

            <article class="glass tier rv{% if block.settings.is_best %} best{% endif %}{% if forloop.index > 1 %} rv-d{{ forloop.index0 | min: 4 }}{% endif %}" {{ block.shopify_attributes }}>
              
              {%- if block.settings.tag != blank -%}
                <span class="tag">{{ block.settings.tag }}</span>
              {%- endif -%}

              <!-- Tier Product Row Illustrations -->
              <div class="tierpix{% if pix_count >= 5 %} five{% endif %}" aria-hidden="true">
                {%- if block.settings.img_1 != 'none' -%}{% render 'purelane-product-vector', type: block.settings.img_1, detailed: false %}{%- endif -%}
                {%- if block.settings.img_2 != 'none' -%}{% render 'purelane-product-vector', type: block.settings.img_2, detailed: false %}{%- endif -%}
                {%- if block.settings.img_3 != 'none' -%}{% render 'purelane-product-vector', type: block.settings.img_3, detailed: false %}{%- endif -%}
                {%- if block.settings.img_4 != 'none' -%}{% render 'purelane-product-vector', type: block.settings.img_4, detailed: false %}{%- endif -%}
                {%- if block.settings.img_5 != 'none' -%}{% render 'purelane-product-vector', type: block.settings.img_5, detailed: false %}{%- endif -%}
              </div>

              <!-- Quantity Info -->
              <div class="qty">
                {{ block.settings.qty }}
                <small>{{ block.settings.qty_label }}</small>
              </div>

              <!-- Price Box -->
              <div class="price">
                {{ block.settings.price }}
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price }}</s>
                {%- endif -%}
              </div>

              <!-- Subtitle per-product cost -->
              {%- if block.settings.subtext != blank -%}
                <p class="body-s" style="font-size:12px">{{ block.settings.subtext }}</p>
              {%- endif -%}

              <!-- Checkmarks Features List -->
              <ul>
                {%- if block.settings.bullet_1 != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.bullet_1 }}
                  </li>
                {%- endif -%}
                {%- if block.settings.bullet_2 != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.bullet_2 }}
                  </li>
                {%- endif -%}
                {%- if block.settings.bullet_3 != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.bullet_3 }}
                  </li>
                {%- endif -%}
                {%- if block.settings.bullet_4 != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m5 13 4 4L19 7"/>
                    </svg>
                    {{ block.settings.bullet_4 }}
                  </li>
                {%- endif -%}
              </ul>

              <!-- Action button -->
              <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.btn_link | default: '#shop' }}">
                {{ block.settings.btn_text }}
                {%- if block.settings.is_best -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                {%- endif -%}
              </a>

            </article>

          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </section>
</div>

