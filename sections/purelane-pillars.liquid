{{ 'section-purelane-pillars.css' | asset_url | stylesheet_tag }}

<div class="purelane-section sec" id="how-{{ section.id }}" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <article class="glass pillar rv" {{ block.shopify_attributes }}>
            <span class="pi">
              {{ block.settings.icon_svg }}
            </span>
            <h3 class="d3">{{ block.settings.title }}</h3>
            <p class="body-s">{{ block.settings.description }}</p>
            {%- if block.settings.btn_text != blank -%}
              <a class="btn btn-ghost btn-sm" href="{{ block.settings.btn_link | default: '#shop' }}">{{ block.settings.btn_text }}</a>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane Pillars",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG Icon HTML"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8.5\" r=\"3.2\"/><circle cx=\"16.4\" cy=\"6.6\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.8\"/><circle cx=\"8.6\" cy=\"15.6\" r=\"2.1\"/><path d=\"M4 21h16\"/></svg>",
            "title": "Less scrubbing",
            "description": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "btn_text": "Learn more"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z\"/><path d=\"m9 12 2.2 2.2L15.4 10\"/></svg>",
            "title": "Clean ingredients",
            "description": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "btn_text": "Learn more"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z\"/></svg>",
            "title": "Safe around everyone",
            "description": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "btn_text": "Learn more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
