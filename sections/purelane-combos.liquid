{{ 'section-purelane-combos.css' | asset_url | stylesheet_tag }}

<div class="purelane-section purelane-combos-section" id="combos" data-scene="3">
  <section class="sec">
    <div class="wrap">
      
      <!-- Panel Header -->
      <div class="panel-head rv">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.headline }}</h2>
        <div class="rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="lede" style="margin:14px auto 0">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      <!-- Combo Rail Scroll Wrapper -->
      <div class="comborail rv">
        {%- for block in section.blocks -%}
          {%- if block.type == 'combo' -%}
            
            {%- assign p1 = block.settings.product_1 -%}
            {%- assign p2 = block.settings.product_2 -%}
            {%- assign p3 = block.settings.product_3 -%}
            {%- assign p4 = block.settings.product_4 -%}
            {%- assign p5 = block.settings.product_5 -%}

            <article class="glass combo{% if block.settings.is_hero_combo %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
              
              <!-- Tray (top half with product stack) -->
              <div class="tray">
                {%- if block.settings.saving_text != blank -%}
                  <span class="save">{{ block.settings.saving_text }}</span>
                {%- endif -%}
                
                {%- if block.settings.flag_text != blank -%}
                  <span class="flag">{{ block.settings.flag_text }}</span>
                {%- endif -%}

                <!-- Horizontal Stack -->
                <div class="stack">
                  <!-- Item 1 -->
                  {%- if p1 != blank or block.settings.fallback_1 != 'none' -%}
                    <span class="it">
                      {%- if p1 != blank -%}
                        <img class="pimg-real" src="{{ p1.featured_image | image_url: width: 140 }}" alt="{{ p1.title | escape }}" loading="lazy">
                      {%- else -%}
                        {%- if block.settings.fallback_1 == 'tile' -%}
                          <span class="tile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                            </svg>
                          </span>
                        {%- else -%}
                          {% render 'purelane-product-vector', type: block.settings.fallback_1, detailed: false %}
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ block.settings.caption_1 }}</span>
                    </span>
                  {%- endif -%}

                  <!-- Item 2 -->
                  {%- if p2 != blank or block.settings.fallback_2 != 'none' -%}
                    <span class="plus" aria-hidden="true">+</span>
                    <span class="it">
                      {%- if p2 != blank -%}
                        <img class="pimg-real" src="{{ p2.featured_image | image_url: width: 140 }}" alt="{{ p2.title | escape }}" loading="lazy">
                      {%- else -%}
                        {%- if block.settings.fallback_2 == 'tile' -%}
                          <span class="tile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                            </svg>
                          </span>
                        {%- else -%}
                          {% render 'purelane-product-vector', type: block.settings.fallback_2, detailed: false %}
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ block.settings.caption_2 }}</span>
                    </span>
                  {%- endif -%}

                  <!-- Item 3 -->
                  {%- if p3 != blank or block.settings.fallback_3 != 'none' -%}
                    <span class="plus" aria-hidden="true">+</span>
                    <span class="it">
                      {%- if p3 != blank -%}
                        <img class="pimg-real" src="{{ p3.featured_image | image_url: width: 140 }}" alt="{{ p3.title | escape }}" loading="lazy">
                      {%- else -%}
                        {%- if block.settings.fallback_3 == 'tile' -%}
                          <span class="tile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                            </svg>
                          </span>
                        {%- else -%}
                          {% render 'purelane-product-vector', type: block.settings.fallback_3, detailed: false %}
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ block.settings.caption_3 }}</span>
                    </span>
                  {%- endif -%}

                  <!-- Item 4 -->
                  {%- if p4 != blank or block.settings.fallback_4 != 'none' -%}
                    <span class="plus" aria-hidden="true">+</span>
                    <span class="it">
                      {%- if p4 != blank -%}
                        <img class="pimg-real" src="{{ p4.featured_image | image_url: width: 140 }}" alt="{{ p4.title | escape }}" loading="lazy">
                      {%- else -%}
                        {%- if block.settings.fallback_4 == 'tile' -%}
                          <span class="tile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                            </svg>
                          </span>
                        {%- else -%}
                          {% render 'purelane-product-vector', type: block.settings.fallback_4, detailed: false %}
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ block.settings.caption_4 }}</span>
                    </span>
                  {%- endif -%}

                  <!-- Item 5 -->
                  {%- if p5 != blank or block.settings.fallback_5 != 'none' -%}
                    <span class="plus" aria-hidden="true">+</span>
                    <span class="it">
                      {%- if p5 != blank -%}
                        <img class="pimg-real" src="{{ p5.featured_image | image_url: width: 140 }}" alt="{{ p5.title | escape }}" loading="lazy">
                      {%- else -%}
                        {%- if block.settings.fallback_5 == 'tile' -%}
                          <span class="tile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                            </svg>
                          </span>
                        {%- else -%}
                          {% render 'purelane-product-vector', type: block.settings.fallback_5, detailed: false %}
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ block.settings.caption_5 }}</span>
                    </span>
                  {%- endif -%}
                </div>
              </div>

              <!-- Body (bottom half with description and prices) -->
              <div class="body">
                <h3>{{ block.settings.title }}</h3>
                <div class="cnt">{{ block.settings.count_text }}</div>
                <p class="inc">{{ block.settings.description }}</p>
                
                <div class="prow">
                  {%- assign final_price = block.settings.custom_price -%}
                  {%- if final_price == blank and p1 != blank -%}
                    {%- assign price_calc = p1.price -%}
                    {%- if p2 != blank -%}{%- assign price_calc = price_calc | plus: p2.price -%}{%- endif -%}
                    {%- if p3 != blank -%}{%- assign price_calc = price_calc | plus: p3.price -%}{%- endif -%}
                    {%- if p4 != blank -%}{%- assign price_calc = price_calc | plus: p4.price -%}{%- endif -%}
                    {%- if p5 != blank -%}{%- assign price_calc = price_calc | plus: p5.price -%}{%- endif -%}
                    {%- assign final_price = price_calc | money -%}
                  {%- elsif final_price != blank -%}
                    {%- assign final_price = final_price | times: 100 | money -%}
                  {%- endif -%}

                  {%- assign compare_price = block.settings.custom_compare_price -%}
                  {%- if compare_price == blank and p1 != blank -%}
                    {%- assign compare_calc = p1.compare_at_price | default: p1.price -%}
                    {%- if p2 != blank -%}{%- assign compare_calc = compare_calc | plus: p2.compare_at_price | default: p2.price -%}{%- endif -%}
                    {%- if p3 != blank -%}{%- assign compare_calc = compare_calc | plus: p3.compare_at_price | default: p3.price -%}{%- endif -%}
                    {%- if p4 != blank -%}{%- assign compare_calc = compare_calc | plus: p4.compare_at_price | default: p4.price -%}{%- endif -%}
                    {%- if p5 != blank -%}{%- assign compare_calc = compare_calc | plus: p5.compare_at_price | default: p5.price -%}{%- endif -%}
                    {%- assign compare_price = compare_calc | money -%}
                  {%- elsif compare_price != blank -%}
                    {%- assign compare_price = compare_price | times: 100 | money -%}
                  {%- endif -%}

                  <strong>{{ final_price | default: block.settings.fallback_price_display }}</strong>
                  {%- if compare_price != blank or block.settings.fallback_compare_display != blank -%}
                    <s>{{ compare_price | default: block.settings.fallback_compare_display }}</s>
                  {%- endif -%}
                  {%- if block.settings.discount_tag != blank -%}
                    <em>{{ block.settings.discount_tag }}</em>
                  {%- endif -%}
                </div>
                
                <div class="fine">{{ section.settings.fine_print }}</div>
                <a class="btn {% if block.settings.is_hero_combo %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.btn_link | default: '#bundles' }}">
                  {{ section.settings.btn_text }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                </a>
              </div>
            </article>

          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Swipe cue indicator -->
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h13m-5-6 6 6-6 6"/>
        </svg>
        {{ section.settings.swipe_cue }}
      </div>
      
      {%- if section.settings.note != blank -%}
        <p class="railnote">{{ section.settings.note }}</p>
      {%- endif -%}

    </div>
  </section>
</div>

