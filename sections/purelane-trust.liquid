{{ 'section-purelane-trust.css' | asset_url | stylesheet_tag }}

<div class="purelane-section sec" id="trust-{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_item' -%}
          <div class="trust-i" {{ block.shopify_attributes }}>
            {{ block.settings.icon_svg }}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane Trust Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG Icon HTML"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Label",
          "default": "Plant derived<br>formulas"
        }
      ]
    }
  ],
